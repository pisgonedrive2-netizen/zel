{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/refresh-links",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-achievements",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/forward-content-telegram",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/tron-sync",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/system-backup",
      "schedule": "0 2 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/forward-content-telegram/route.ts": {
      "maxDuration": 180
    },
    "src/app/api/cron/sync-achievements/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/admin/telegram-content/route.ts": {
      "maxDuration": 180
    }
  }
}
